{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": ["**/node_modules/**", "themes/PaperMod/**"],
  "automerge": true,
  "ignoreTests": false,
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Playwright bumps change rendering; update together and regenerate baselines",
      "matchPackageNames": [
        "@playwright/test",
        "playwright",
        "@axe-core/playwright"
      ],
      "groupName": "playwright"
    }
  ]
}
